# ═══════════════════════════════════════════════════════════════
# ApexRAG — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and adjust values for your setup.
# All variables are OPTIONAL — sensible defaults are used when
# a variable is not set.
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────
# SQLAlchemy async database URL.
#   SQLite:    sqlite+aiosqlite:///./apex.db
#   Postgres:  postgresql+asyncpg://user:pass@host:5432/dbname
# APEX_DB_URL=sqlite+aiosqlite:///apex.db

# Log all SQL queries (true/false). Dev only.
# APEX_DB_ECHO=false

# Connection pool size (PostgreSQL only; ignored for SQLite).
# APEX_DB_POOL_SIZE=10

# Max overflow connections (PostgreSQL only; ignored for SQLite).
# APEX_DB_MAX_OVERFLOW=20

# ── LLM / Ollama Provider ─────────────────────────────────────────────────
# Host URL for the Ollama server.
# APEX_OLLAMA_HOST=http://localhost:11434

# Timeout in seconds for Ollama API calls.
# APEX_OLLAMA_TIMEOUT=120

# LLM model for navigation decisions (e.g., llama3.1, mistral, phi3).
# APEX_MODEL=llama3.1

# Smaller/faster model for summary generation during ingestion.
# Falls back to APEX_MODEL if not set.
# APEX_SUMMARISER_MODEL=

# Model for leaf verification.
# Falls back to APEX_MODEL if not set.
# APEX_VERIFIER_MODEL=

# Model for cross-document answer synthesis.
# Falls back to APEX_MODEL if not set.
# APEX_AGGREGATOR_MODEL=

# ── Ingestion ─────────────────────────────────────────────────────────────
# Document parser backend: "markitdown" (default), "docling", or "plaintext".
# APEX_PARSER_BACKEND=markitdown

# Max parallel LLM calls during summary generation.
# Higher values = faster ingestion for large docs.
# APEX_MAX_CONCURRENT_SUMMARIES=10

# Enable/disable leaf verification during queries (true/false).
# APEX_VERIFY=true

# ── API Server ────────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins. Use "*" to allow all.
# APEX_CORS_ORIGINS=*

# Bearer token for API authentication. Leave empty to disable.
# APEX_API_KEY=

# Request rate limit (N/minute).
# APEX_RATE_LIMIT=60/minute

# Max upload file size in MB.
# APEX_MAX_UPLOAD_MB=50

# ── Observability ─────────────────────────────────────────────────────────
# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
# APEX_LOG_LEVEL=INFO

# Log output format: "rich" (human-readable) or "json" (log aggregators).
# APEX_LOG_FORMAT=rich

# Enable colour-coded navigation trace output (true/false).
# APEX_TRACE_ENABLED=true

# ── File Paths ────────────────────────────────────────────────────────────
# Data directory for file storage.
# APEX_DATA_DIR=.
